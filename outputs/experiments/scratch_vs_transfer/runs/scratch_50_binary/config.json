{
  "data": {
    "image_size": 64,
    "num_workers": 0
  },
  "model": {
    "name": "scratch_cnn",
    "dropout": 0.3
  },
  "optimizer": {
    "name": "adam",
    "lr": 0.001,
    "weight_decay": 0.0001
  },
  "training": {
    "batch_size": 64,
    "max_epochs": 50,
    "early_stopping_patience": 7,
    "checkpoint_criterion": "val_loss"
  },
  "augmentation": {
    "random_horizontal_flip": true,
    "random_vertical_flip": true,
    "random_rotation_degrees": 15
  },
  "smoke": {
    "epochs": 1,
    "limit_per_class": 8
  },
  "_runtime": {
    "task": "binary",
    "smoke": false,
    "limit_per_class": 50,
    "device_request": "mps",
    "run_name": "scratch_50_binary",
    "evaluate_test": true,
    "overfit_samples": null
  }
}
